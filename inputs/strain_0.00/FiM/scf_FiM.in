    occupations   = 'smearing'
    smearing      = 'mv'
    degauss       = 0.01
/
&ELECTRONS
    diagonalization = 'david'
    mixing_mode     = 'plain'
    mixing_beta     = 0.7
    conv_thr        = 1.0d-10
/
