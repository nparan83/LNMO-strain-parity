&CONTROL
    calculation   = 'scf'
    restart_mode  = 'from_scratch'
    prefix        = 'lnmo_AFM_0.00'
    outdir        = './tmp'
    pseudo_dir    = '/arf/scratch/nparan/lnmo/pseudo'
    verbosity     = 'high'
    etot_conv_thr = 1.0d-6
    forc_conv_thr = 1.0d-4
/
&SYSTEM
    ibrav         = 0
    nat           = 20
    ntyp          = 6
    ecutwfc       = 90.0
    ecutrho       = 900.0
    nspin         = 2
    starting_magnetization(1) = 0.0
    starting_magnetization(2) = 0.5
