&CONTROL
    calculation   = 'vc-relax'
    restart_mode  = 'from_scratch'
    prefix        = 'lnmo_AFM_-0.03'
    outdir        = './tmp'
    pseudo_dir    = '/arf/scratch/nparan/lnmo/pseudo'
    verbosity     = 'high'
    etot_conv_thr = 1.0d-6
    forc_conv_thr = 1.0d-4
/
&SYSTEM
    ibrav         = 0
    nat           = 20
    ntyp          = 6
    ecutwfc       = 90.0
    ecutrho       = 900.0
    nspin         = 2
    starting_magnetization(1) = 0.0
    starting_magnetization(2) = 0.5
    starting_magnetization(3) = -0.5
    starting_magnetization(4) = 0.5
    starting_magnetization(5) = -0.5
    starting_magnetization(6) = 0.0
    occupations   = 'smearing'
    smearing      = 'mv'
    degauss       = 0.01
/
&ELECTRONS
    diagonalization = 'david'
    mixing_mode     = 'plain'
    mixing_beta     = 0.7
    conv_thr        = 1.0d-8
/
&IONS
    ion_dynamics    = 'bfgs'
/
&CELL
    cell_dynamics   = 'bfgs'
    press           = 0.0
    press_conv_thr  = 0.1
    cell_dofree     = 'epitaxial_ab'
/
